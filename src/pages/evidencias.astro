	@media(min-width:45em){.filters{grid-template-columns:repeat(2,minmax(0,1fr))}.filter-search{grid-column:1/-1}.filters>p{grid-column:1/-1}.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr));padding:1rem}.activity-card[open]{grid-column:1/-1}.section-summary{grid-template-columns:1fr auto auto;padding:1.15rem 1.3rem}.activity-body{padding:1.2rem}}
	@media(min-width:65em){.filters{grid-template-columns:minmax(14rem,2fr) repeat(3,minmax(8rem,1fr)) auto}.filter-search{grid-column:auto}}
	@media(min-width:72em){.activity-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.activity-card[open]{grid-column:1/-1}.intro{padding-top:2rem}}
