---

import BaseLayout from '../layouts/BaseLayout.astro';
import { order, sectionsData, totalCards, totalFiles, topicList } from '../data/portfolio';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const urlFor = (path: string) => baseUrl + 'recursos/' + path.split('/').map(encodeURIComponent).join('/');
const previewUrl = (path: string) => baseUrl + 'previews/' + path.split('/').map(encodeURIComponent).join('/') + '.html';
const isPreviewable = (path: string) => /\.(pdf|sql|js|txt|pptx|docx|xlsx|zip)$/i.test(path);
const isTextPreview = (path: string) => /\.(sql|js|txt)$/i.test(path);
const previewType = (path: string) => path.toLowerCase().endsWith('.pptx') ? 'Diapositivas e imágenes' : path.toLowerCase().endsWith('.docx') ? 'Texto y tablas del documento' : path.toLowerCase().endsWith('.xlsx') ? 'Hojas de cálculo y valores' : path.toLowerCase().endsWith('.zip') ? 'Archivos y scripts incluidos' : path.toLowerCase().endsWith('.pdf') ? 'Documento PDF' : 'Texto y código';
const subjectOptions = [
	{ value: 'sql-review', label: 'Repaso SQL' },
	{ value: 'plsql', label: 'PL/SQL' },
	{ value: 'sql-advanced', label: 'SQL avanzado' },
	{ value: 'mql', label: 'MQL · MongoDB' },
	{ value: 'etl-elt', label: 'ETL / ELT' },
];
const subjectsFor = (card: any) => {
	// El filtro identifica el enfoque principal declarado por la evidencia,
	// sin heredar categorías de recursos secundarios o menciones en el texto.
	const text = `${card.title} ${card.topic}`.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
	const subjects: string[] = [];
	if (/\betl\b|\belt\b|integracion y transformacion de datos/.test(text)) subjects.push('etl-elt');
	if (/mongo(db)?|\bmql\b|bases de datos documentales/.test(text)) subjects.push('mql');
	const isPlsql = /pl\s*\/?\s*sql|plsql/.test(text);
	if (isPlsql) subjects.push('plsql');
	const isAdvancedSql = /sql avanzado|sql[- ]tuning|tuning de consultas|optimizacion|concurrencia|transacciones|bloqueos|indices oracle|clustering factor|histogramas|feedback|metodos de join|planes de ejecucion/.test(text);
	if (isAdvancedSql) subjects.push('sql-advanced');
	else if (!isPlsql && /\bsql\b|consultas sql|select|joins|subqueries|subconsultas|operadores de conjuntos|capitulos? 1.?9/.test(text)) subjects.push('sql-review');
	return subjects;
};
const subjectLabel = (value: string) => subjectOptions.find((subject) => subject.value === value)?.label ?? value;
---

<BaseLayout title="Evidencias | Bases de Datos II" description="Portafolio académico organizado por entregas, laboratorios, lecturas, prácticas y presentaciones, con recursos relacionados y vistas previas.">
	<main class="wrapper archive">
		<header class="intro">
			<p class="eyebrow">BASES DE DATOS II · PORTAFOLIO ACADÉMICO</p>
			<h1>Un semestre, conectado</h1>
			<p>Explora las evidencias en el orden del portafolio. Cada tarjeta abre una página propia con explicación extensa, aprendizajes, anotaciones y vista previa del material. La organización por entregas, laboratorios, lecturas, prácticas y presentaciones conserva la relación entre evidencias; en cada taller se distinguen la consigna y sus recursos de desarrollo.</p>
			<div class="summary-line"><span><b>{totalCards}</b> tarjetas de evidencia</span><i>·</i><span><b>{totalFiles}</b> archivos incluidos</span><i>·</i><span>Enlaces externos separados</span></div>
		</header>

		<nav class="section-nav" aria-label="Orden de secciones">
			{sectionsData.map(({ section }, index) => <a href={`#${section.toLowerCase().replaceAll(' ', '-')}`}><span>0{index + 1}</span>{section}</a>)}
		</nav>

		<section class="filters" aria-label="Filtros del portafolio">
			<div class="filter-search"><label for="search">Buscar por actividad, archivo o concepto</label><input id="search" type="search" placeholder="Ej. enunciado, índices, cursores…" autocomplete="off" /></div>
			<div><label for="section-filter">Sección</label><select id="section-filter"><option value="">Todas</option>{order.map((section) => <option value={section}>{section}</option>)}</select></div>
			<div><label for="subject-filter">Área de estudio</label><select id="subject-filter"><option value="">Todas las áreas</option>{subjectOptions.map((subject) => <option value={subject.value}>{subject.label}</option>)}</select></div>
			<div><label for="topic-filter">Tema</label><select id="topic-filter"><option value="">Todos</option>{topicList.map((topic) => <option value={topic}>{topic}</option>)}</select></div>
			<button id="clear-filters" type="button">Limpiar</button>
		<p id="result-count" aria-live="polite">{totalCards} tarjetas · {totalFiles} archivos</p>
		</section>

		<div class="empty-state" id="empty-state" hidden><h2>No encontramos actividades</h2><p>Prueba otra palabra o limpia alguno de los filtros para ver más resultados.</p></div>

		<div class="sections">
			{sectionsData.map(({ section, info, cards, groups }, sectionIndex) => <details class="library-section" id={section.toLowerCase().replaceAll(' ', '-')} data-section={section}>
				<summary class="section-summary"><span class="section-heading"><span class="section-order">{String(sectionIndex + 1).padStart(2, '0')}</span><span class="section-name">{section}</span></span><span class="section-number">{String(cards.length).padStart(2, '0')} evidencias</span><span class="section-description">{info}</span><span class="chevron" aria-hidden="true">⌄</span></summary>
				<div class="topic-groups">{groups.map((group, groupIndex) => <details class="topic-group" data-topic-group={group.topic}><summary class="topic-heading"><span class="topic-order">GRUPO {String(groupIndex + 1).padStart(2, '0')}</span><h3>{group.topic}</h3><span class="topic-count">{String(group.cards.length).padStart(2, '0')} {group.cards.length === 1 ? 'tarjeta' : 'tarjetas'}</span><span class="topic-chevron" aria-hidden="true">⌄</span></summary>
					<div class="topic-content"><div class="activity-grid">{group.cards.map((card) => {
						const searchIndex = `${card.title} ${card.topic} ${card.kind} ${card.intro} ${card.extended ?? ''} ${card.reflection ?? ''} ${card.learning.join(' ')} ${card.note} ${card.directUrl ?? ''} ${card.files.map((f) => `${f.title} ${f.path} ${f.role} ${f.description} ${f.learning} ${f.externalUrl ?? ''}`).join(' ')}`;
						return <article class="activity-card" data-search={searchIndex} data-section={section} data-topic={card.topic} data-kind={card.kind} data-subjects={subjectsFor(card).join('|')} data-file-count={card.files.length || 1}>
							<div class="activity-summary"><span class="activity-topic">{card.topic}</span><span class="kind-badge">{card.kind}</span>{subjectsFor(card).length > 0 && <div class="area-tags" aria-label="Enfoques principales">{subjectsFor(card).map((subject) => <span class="area-chip" data-area={subject}>{subjectLabel(subject)}</span>)}</div>}<h2>{card.title}</h2><div class="card-copy"><div class="card-copy-part"><span>QUÉ CONTIENE</span><p>{card.intro}</p></div><div class="card-copy-part learning-preview"><span>APRENDIZAJE CLAVE</span><p>{card.learning[0]}</p></div></div><div class="card-bottom"><span class="file-count">{card.files.length ? `${card.files.length} ${card.files.length === 1 ? 'recurso' : 'recursos'}` : 'Enlace externo'}</span><a class="detail-link" href={`${baseUrl}evidencias/${card.slug}/`}>Ver explicación y archivos <span aria-hidden="true">↗</span></a></div></div>
						</article>;
					})}</div></div>
				</details>)}</div>
			</details>)}
		</div>
		<footer class="closing-note">PDF, presentaciones, documentos, hojas de cálculo, archivos comprimidos y texto/código cuentan con una vista previa dentro de la ficha. El archivo original permanece disponible para consulta.</footer>
	</main>

	<script>
		const search = document.querySelector<HTMLInputElement>('#search')!;
		const sectionSelect = document.querySelector<HTMLSelectElement>('#section-filter')!;
		const topicSelect = document.querySelector<HTMLSelectElement>('#topic-filter')!;
		const subjectSelect = document.querySelector<HTMLSelectElement>('#subject-filter')!;
		const clearButton = document.querySelector<HTMLButtonElement>('#clear-filters')!;
		const cards = [...document.querySelectorAll<HTMLElement>('.activity-card')];
		const sections = [...document.querySelectorAll<HTMLDetailsElement>('.library-section')];
		const topicGroups = [...document.querySelectorAll<HTMLDetailsElement>('.topic-group')];
		const resultCount = document.querySelector<HTMLElement>('#result-count')!;
		const emptyState = document.querySelector<HTMLElement>('#empty-state')!;
		const loadedText = new Set<string>();
		const autoOpenedGroups = new Set<HTMLDetailsElement>();
		const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
		const initialTopics = [...topicSelect.options].slice(1).map((option) => ({ value: option.value, label: option.textContent ?? option.value }));
		const updateTopics = () => {
			const current = topicSelect.value;
			const relevant = cards.filter((card) => !sectionSelect.value || card.dataset.section === sectionSelect.value);
			const values = new Set(relevant.map((card) => card.dataset.topic));
			topicSelect.replaceChildren(new Option('Todos', ''), ...initialTopics.filter((topic) => values.has(topic.value)).map((topic) => new Option(topic.label, topic.value)));
			if ([...topicSelect.options].some((option) => option.value === current)) topicSelect.value = current;
		};
		const applyFilters = () => {
			const terms = normalize(search.value).split(/\s+/).filter(Boolean);
			let activityCount = 0; let fileCount = 0;
			cards.forEach((card) => {
				const text = normalize(card.dataset.search ?? '');
				const subjects = (card.dataset.subjects ?? '').split('|');
				const matches = terms.every((term) => text.includes(term)) && (!sectionSelect.value || card.dataset.section === sectionSelect.value) && (!topicSelect.value || card.dataset.topic === topicSelect.value) && (!subjectSelect.value || subjects.includes(subjectSelect.value));
				card.hidden = !matches;
				if (matches) { activityCount++; fileCount += Number(card.dataset.fileCount ?? 0); }
			});
			const filtering = !!(terms.length || sectionSelect.value || topicSelect.value || subjectSelect.value);
			topicGroups.forEach((group) => {
				const hasMatch = !!group.querySelector('.activity-card:not([hidden])');
				group.hidden = !hasMatch;
				if (filtering && hasMatch && !group.open) { group.open = true; autoOpenedGroups.add(group); }
				if (!filtering && autoOpenedGroups.has(group)) { group.open = false; autoOpenedGroups.delete(group); }
			});
			sections.forEach((section) => { const hasMatch = !!section.querySelector('.activity-card:not([hidden])'); section.hidden = !hasMatch; if (filtering) section.open = hasMatch; });
			emptyState.hidden = activityCount > 0;
			resultCount.textContent = `${activityCount} ${activityCount === 1 ? 'actividad' : 'actividades'} · ${fileCount} ${fileCount === 1 ? 'archivo' : 'archivos'}`;
		};
		const loadTextPreview = async (row: HTMLDetailsElement) => {
			const pre = row.querySelector<HTMLPreElement>('[data-text-url]'); const url = pre?.dataset.textUrl;
			if (!pre || !url || loadedText.has(url)) return;
			loadedText.add(url);
			try { const response = await fetch(url); if (!response.ok) throw new Error('No disponible'); const text = await response.text(); pre.textContent = text.length > 24000 ? `${text.slice(0, 24000)}\n\n…Vista previa recortada; abre el archivo original para consultar el contenido completo.` : text; }
			catch { pre.textContent = 'No se pudo cargar la vista previa. Abre el archivo original para consultarlo.'; }
		};
		cards.forEach((card) => card.addEventListener('toggle', () => { if (card.open) { loadTextPreview(card); card.querySelectorAll<HTMLDetailsElement>('.file-item[open]').forEach(loadTextPreview); } }));
		document.querySelectorAll<HTMLDetailsElement>('.file-item').forEach((row) => row.addEventListener('toggle', () => { if (row.open) loadTextPreview(row); }));
		search.addEventListener('input', applyFilters);
		sectionSelect.addEventListener('change', () => { updateTopics(); applyFilters(); });
		topicSelect.addEventListener('change', applyFilters); subjectSelect.addEventListener('change', applyFilters);
		clearButton.addEventListener('click', () => { search.value = ''; sectionSelect.value = ''; subjectSelect.value = ''; updateTopics(); topicSelect.value = ''; applyFilters(); search.focus(); });
	document.querySelectorAll<HTMLAnchorElement>('.section-nav a').forEach((link) => link.addEventListener('click', (event) => {
		event.preventDefault();
		const target = document.getElementById(link.getAttribute('href')!.slice(1)) as HTMLDetailsElement | null;
		if (target) { target.open = true; const firstGroup = target.querySelector<HTMLDetailsElement>('.topic-group'); if (firstGroup) firstGroup.open = true; target.scrollIntoView({ behavior: 'smooth', block: 'start' }); history.replaceState(null, '', link.hash); }
	}));
	</script>
</BaseLayout>

