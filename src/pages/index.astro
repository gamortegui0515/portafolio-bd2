---
import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const areas = [
	['📚', 'Lecturas', 'Apuntes, artículos y reflexiones.'],
	['💻', 'Trabajos', 'Actividades y entregables del curso.'],
	['📝', 'Evidencias', 'SQL, PL/SQL, NoSQL y proyecto.'],
	['🔎', 'Investigaciones', 'Exploraciones sobre datos y tecnología.'],
	['📄', 'Entregas', 'Documentos y avances del semestre.'],
	['🗃️', 'Proyectos', 'Soluciones construidas durante la asignatura.'],
];
---

<BaseLayout title="Bases de Datos II | Gabriel Amortegui">
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-20 lg:gap-30">
			<header class="hero">
				<Hero title="Bases de Datos II" tagline="Portafolio académico · Gabriel Amortegui" align="start">
					<div class="roles">
						<Pill><Icon icon="code" size="1.2em" /> Ingeniería de Sistemas</Pill>
						<Pill><Icon icon="terminal-window" size="1.2em" /> Quinto semestre</Pill>
					</div>
					<p class="intro">Un espacio para documentar mi avance, construir conocimiento y compartir las evidencias de mi proceso en bases de datos.</p>
					<CallToAction href={`${base}presentacion/`}>Ver presentación <Icon icon="arrow-right" size="1.2em" /></CallToAction>
				</Hero>
				<img src={`${base}assets/gabriel-amortegui.png`} alt="Gabriel Amortegui" width="1124" height="1404" />
			</header>

			<section class="portfolio-note">
				<p class="eyebrow">Sobre el portafolio</p>
				<p>“Una recopilación de mi proceso de aprendizaje durante la asignatura Bases de Datos II, donde iré registrando las actividades, evidencias, investigaciones, trabajos y proyectos desarrollados durante el semestre.”</p>
			</section>
		</div>

		<main class="wrapper">
			<section class="areas" aria-labelledby="areas-title">
				<header><p class="eyebrow">Organización del semestre</p><h2 id="areas-title">Contenido del portafolio</h2></header>
				<div class="area-grid">
					{areas.map(([emoji, title, description]) => <a href={`${base}evidencias/`} class="area-card"><span>{emoji}</span><h3>{title}</h3><p>{description}</p></a>)}
				</div>
			</section>
		</main>
	</div>
</BaseLayout>

<style>
	.hero { display: flex; flex-direction: column; align-items: center; gap: 2rem; }
	.hero :global(.intro) { max-width: 48ch; color: var(--gray-300); font-size: var(--text-md); }
	.roles { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .5rem; }
	.hero > img { width: min(100%, 25rem); aspect-ratio: 4 / 5; object-fit: cover; object-position: center 12%; border-radius: 2rem; box-shadow: var(--shadow-md); }
	.eyebrow { color: var(--accent-regular); font-family: var(--font-brand); font-size: var(--text-sm); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
	.portfolio-note { max-width: 65ch; margin: 0 auto; padding: 2rem; border-left: 3px solid var(--accent-regular); border-radius: 0 1.25rem 1.25rem 0; background: var(--gradient-subtle); color: var(--gray-200); font-size: var(--text-lg); box-shadow: var(--shadow-sm); }
	.portfolio-note p + p { margin-top: .75rem; }
	.areas { display: grid; gap: 2rem; }
	.areas header { text-align: center; }
	.areas h2 { margin-top: .5rem; font-size: var(--text-3xl); }
	.area-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; }
	.area-card { display: grid; gap: .5rem; min-height: 12rem; padding: 1.5rem; color: var(--gray-200); text-decoration: none; border: 1px solid var(--gray-800); border-radius: 1.25rem; background: var(--gradient-subtle); box-shadow: var(--shadow-sm); transition: transform var(--theme-transition), box-shadow var(--theme-transition); }
	.area-card:hover, .area-card:focus { transform: translateY(-.25rem); box-shadow: var(--shadow-md); }
	.area-card span { font-size: 1.75rem; }
	.area-card h3 { font-size: var(--text-xl); }
	.area-card p { color: var(--gray-300); }
	@media (min-width: 50em) { .hero { display: grid; grid-template-columns: 6fr 4fr; padding-inline: 2.5rem; gap: 3.75rem; } .hero > img { justify-self: end; border-radius: 4rem; } .areas { gap: 3rem; } }
</style>
