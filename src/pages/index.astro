---
import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
	const areas = [
		['01', 'Repaso SQL', 'Un recorrido desde SELECT y filtros hasta funciones, agregación, joins, subconsultas y operadores de conjuntos.'],
		['02', 'SQL avanzado', 'Planes de ejecución, optimización, índices, transacciones, estadísticas y concurrencia en Oracle.'],
		['03', 'PL/SQL', 'Bloques, control, cursores, funciones, procedimientos, excepciones y triggers.'],
		['04', 'MongoDB y MQL', 'Modelado documental, consultas y operaciones aplicadas a los talleres y ejercicios del semestre.'],
		['05', 'ETL / ELT', 'Lectura comparativa de los flujos de integración: dónde se transforman los datos y por qué importa para la arquitectura.'],
		['06', 'Proyecto MotoGo', 'Requerimientos, modelos, diccionario, decisiones técnicas y cierre ejecutivo conectados en una sola entrega.'],
	];
	const technologies = [
		['Java', 'java'], ['Spring Boot', 'spring'], ['Oracle SQL', 'oracle'], ['MongoDB', 'mongodb'],
		['Angular', 'angular'], ['HTML5', 'html5'], ['CSS3', 'css3'], ['MySQL', 'mysql'],
	];
---

<BaseLayout title="Bases de Datos II | Gabriel Amortegui">
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-20 lg:gap-30">
			<header class="hero">
				<Hero title="Bases de Datos II" tagline="Portafolio académico · Gabriel Amortegui" align="start">
					<div class="roles">
						<Pill><Icon icon="code" size="1.2em" /> Ingeniería de Sistemas</Pill>
						<Pill><Icon icon="terminal-window" size="1.2em" /> Quinto semestre</Pill>
					</div>
						<p class="intro">Una bitácora comentada de Bases de Datos II: cada entrega se conecta con los conceptos, las decisiones y las prácticas que permiten diseñar y administrar bases de datos con rigor.</p>
						<CallToAction href={`${base}evidencias/`}>Explorar evidencias <Icon icon="arrow-right" size="1.2em" /></CallToAction>
				</Hero>
				<img src={`${base}assets/gabriel-amortegui.png`} alt="Gabriel Amortegui" width="1124" height="1404" />
			</header>

			<section class="portfolio-note">
				<p class="eyebrow">Sobre el portafolio</p>
					<p>El archivo reúne lecturas, prácticas, laboratorios, talleres, evaluaciones y el proyecto integrador. Las descripciones explican el propósito de cada material y cómo se relaciona con los demás temas del semestre.</p>
			</section>
		</div>

		<main class="wrapper">
			<section class="areas" aria-labelledby="areas-title">
				<header><p class="eyebrow">Organización del semestre</p><h2 id="areas-title">Contenido del portafolio</h2></header>
				<div class="area-grid">
					{areas.map(([number, title, description]) => <a href={`${base}evidencias/`} class="area-card"><span>{number}</span><h3>{title}</h3><p>{description}</p><b>Ver materiales <span aria-hidden="true">↗</span></b></a>)}
				</div>
			</section>
			<section class="tech-section" aria-labelledby="tech-title">
				<header class="tech-heading"><p class="eyebrow">Herramientas y lenguajes</p><h2 id="tech-title">Tecnologías que utilizo</h2><p>Una selección de tecnologías que forman parte de mi recorrido académico y de desarrollo.</p></header>
				<ul class="tech-list">{technologies.map(([name, icon]) => <li class="tech-item"><img src={`${base}assets/technologies/${icon}.svg`} alt="" loading="lazy" width="48" height="48"/><span>{name}</span></li>)}</ul>
			</section>
			<section class="contact-strip" aria-labelledby="contact-title">
				<div><p class="eyebrow">Contacto</p><h2 id="contact-title">Conectemos</h2><p>Para conversar sobre el portafolio, proyectos o desarrollo de software.</p></div>
				<div class="contact-links">
					<a class="contact-link email-link" href="mailto:gamorteguih@unbosque.edu.co"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17v11h-17z"/><path d="m4 7 8 6 8-6"/></svg><span><small>Escríbeme</small><b>gamorteguih@unbosque.edu.co</b></span><i aria-hidden="true">↗</i></a>
					<a class="contact-link github-link" href="https://github.com/gamortegui0515" target="_blank" rel="noopener"><Icon icon="github-logo" size="1.7rem"/><span><small>Explora mi código</small><b>GitHub · gamortegui0515</b></span><i aria-hidden="true">↗</i></a>
				</div>
			</section>
		</main>
	</div>
</BaseLayout>

<style>
	.hero { position:relative; display: flex; flex-direction: column; align-items: center; gap: 2rem; padding:clamp(1.25rem,4vw,3.25rem); border:1px solid var(--gray-800); border-radius:1.5rem; background:radial-gradient(ellipse at 4% 0%,color-mix(in srgb,var(--portfolio-blue) 14%,transparent),transparent 43%),radial-gradient(ellipse at 100% 100%,color-mix(in srgb,var(--portfolio-violet) 9%,transparent),transparent 40%),var(--gray-999); box-shadow:var(--shadow-sm); }
	.hero :global(.intro) { max-width: 48ch; color: var(--gray-300); font-size: var(--text-md); }
	.roles { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .5rem; }
	.hero > img { width: min(100%, 25rem); aspect-ratio: 4 / 5; object-fit: cover; object-position: center 12%; border:1px solid color-mix(in srgb,var(--portfolio-blue) 35%,var(--gray-800)); border-radius: 2rem; box-shadow:0 18px 50px color-mix(in srgb,var(--portfolio-blue) 14%,transparent),var(--shadow-md); }
	.eyebrow { color: var(--accent-regular); font-family: var(--font-brand); font-size: var(--text-sm); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
	.portfolio-note { position:relative;max-width: 65ch; margin: 0 auto; padding: 2rem; border:1px solid color-mix(in srgb,var(--portfolio-teal) 24%,var(--gray-800));border-left: 3px solid var(--portfolio-teal); border-radius: 0 1.25rem 1.25rem 0; background:linear-gradient(110deg,color-mix(in srgb,var(--portfolio-teal) 7%,var(--gray-999)),var(--gray-999)); color: var(--gray-200); font-size: var(--text-lg); box-shadow: 0 10px 30px color-mix(in srgb,var(--portfolio-teal) 6%,transparent); }
	.portfolio-note p + p { margin-top: .75rem; }
	.areas { display: grid; gap: 2rem; }
	.areas header { position:relative;display:grid;justify-items:center;text-align: center; }
	.areas header:after{width:3.5rem;height:3px;margin-top:1rem;border-radius:99px;background:linear-gradient(90deg,var(--portfolio-blue),var(--portfolio-violet),var(--portfolio-rose));content:""}
	.areas h2 { margin-top: .5rem; font-size: var(--text-3xl); }
	.area-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,23rem), 1fr)); column-gap:2rem; }
	.area-card { position:relative;display:grid;grid-template-columns:2.5rem minmax(0,1fr) auto;align-items:center;column-gap:.8rem;row-gap:.3rem;min-height:0;padding:1.05rem .7rem;color:var(--gray-200);text-decoration:none;border:0;border-bottom:1px solid color-mix(in srgb,var(--card-accent) 20%,var(--gray-800));border-radius:0;background:transparent;transition:transform var(--theme-transition),background-color var(--theme-transition),border-color var(--theme-transition); }
	.area-card:before{position:absolute;inset:auto auto 0 0;width:0;height:2px;background:var(--card-accent);content:"";transition:width .25s ease}
	.area-card:nth-child(6n+1){--card-accent:var(--portfolio-blue)}.area-card:nth-child(6n+2){--card-accent:var(--portfolio-violet)}.area-card:nth-child(6n+3){--card-accent:var(--portfolio-teal)}.area-card:nth-child(6n+4){--card-accent:var(--portfolio-amber)}.area-card:nth-child(6n+5){--card-accent:var(--portfolio-rose)}.area-card:nth-child(6n+6){--card-accent:var(--portfolio-blue)}
	.area-card:hover, .area-card:focus-visible { transform:translateX(.22rem);background:linear-gradient(90deg,color-mix(in srgb,var(--card-accent) 7%,transparent),transparent 85%); }
	.area-card:hover:before,.area-card:focus-visible:before{width:4rem}
	.area-card > span { grid-column:1;grid-row:1/4;display:inline-grid;place-items:center;width:2.2rem;height:2.2rem;border-radius:50%;background:color-mix(in srgb,var(--card-accent) 10%,transparent);color:var(--card-accent);font-family:var(--font-brand);font-size:.78rem;font-weight:800;letter-spacing:.08em; }
	.area-card h3 { grid-column:2/-1;align-self:end;font-size:1.1rem; }
	.area-card p { grid-column:2/-1;align-self:start;color: var(--gray-400);font-size:.88rem;line-height:1.6; }
	.area-card b { grid-column:2/-1;display:flex;justify-content:space-between;align-items:center;margin-top:.35rem;color:var(--card-accent);font-size:.78rem; }
	.area-card b span{transition:transform .2s}.area-card:hover b span{transform:translate(3px,-3px)}
	.tech-section{display:grid;gap:1.5rem;margin-top:clamp(3rem,7vw,6rem);padding-block:1.5rem 2rem;border-block:1px solid var(--gray-800)}
	.tech-heading h2,.contact-strip h2{margin-top:.35rem;font-size:clamp(1.6rem,3.5vw,2.35rem);letter-spacing:-.035em}
	.tech-heading>p:last-child,.contact-strip>div>p:last-child{margin-top:.45rem;color:var(--gray-400);font-size:.9rem;line-height:1.7}
	.tech-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.25rem 1rem;margin:0;padding:0;list-style:none}
	.tech-item{display:flex;align-items:center;gap:.75rem;min-width:0;padding:.7rem .35rem;border-bottom:1px solid color-mix(in srgb,var(--gray-800) 75%,transparent);color:var(--gray-300);font-size:.88rem;font-weight:650;transition:color .2s,transform .2s}
	.tech-item img{width:2.3rem;height:2.3rem;object-fit:contain;transition:transform .25s ease,filter .25s ease}
	.tech-item:hover{color:var(--gray-100);transform:translateX(.2rem)}.tech-item:hover img{transform:scale(1.12) rotate(-4deg);filter:drop-shadow(0 5px 8px color-mix(in srgb,var(--accent-regular) 22%,transparent))}
	.contact-strip{display:grid;gap:1.5rem;align-items:center;margin:clamp(3rem,7vw,6rem) 0 1rem;padding:1.5rem 0;border-top:1px solid var(--gray-800)}
	.contact-links{display:grid;gap:.4rem}
	.contact-link{display:flex;align-items:center;gap:.8rem;min-width:0;padding:.75rem .2rem;border-bottom:1px solid color-mix(in srgb,var(--contact-accent) 22%,var(--gray-800));color:var(--gray-200);text-decoration:none;transition:color .2s,border-color .2s,transform .2s}
	.email-link{--contact-accent:var(--portfolio-teal)}.github-link{--contact-accent:var(--portfolio-violet)}
	.contact-link svg{flex:0 0 1.55rem;width:1.55rem;height:1.55rem;fill:none;stroke:var(--contact-accent);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
	.contact-link>span{display:grid;gap:.2rem;min-width:0}.contact-link small{color:var(--gray-500);font-size:.68rem}.contact-link b{color:var(--contact-accent);font-size:clamp(.82rem,1.8vw,.98rem);overflow-wrap:anywhere}.contact-link i{margin-left:auto;color:var(--contact-accent);font-size:1.1rem;font-style:normal;transition:transform .2s}
	.contact-link:hover{transform:translateX(.2rem);border-color:var(--contact-accent)}.contact-link:hover i{transform:translate(3px,-3px)}
	@media (min-width: 50em) { .hero { display: grid; grid-template-columns: 6fr 4fr; padding-inline: clamp(2.5rem,5vw,4rem); gap: 3.75rem; } .hero > img { justify-self: end; border-radius: 2.5rem; } .areas { gap: 3rem; }.tech-section{grid-template-columns:minmax(12rem,.75fr) minmax(0,1.5fr);align-items:center;gap:2rem}.tech-list{grid-template-columns:repeat(4,minmax(0,1fr))}.contact-strip{grid-template-columns:.8fr 1.2fr;gap:3rem}.contact-links{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem} }
	@media(max-width:32em){.hero{padding:1rem;border-radius:1rem}.hero>img{width:min(100%,20rem);border-radius:1.2rem}.portfolio-note{padding:1.2rem;font-size:1rem}.area-grid{grid-template-columns:minmax(0,1fr)}.area-card{grid-template-columns:2rem minmax(0,1fr);padding:.9rem .25rem}.area-card>span{width:1.8rem;height:1.8rem}.area-card h3,.area-card p,.area-card b{grid-column:2}.area-card>span{grid-row:1/4}.tech-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:.2rem .6rem}.tech-item{gap:.55rem;font-size:.8rem}.tech-item img{width:2rem;height:2rem}.contact-link{gap:.6rem}.contact-link b{font-size:.78rem}}
	@media(prefers-reduced-motion:reduce){.area-card,.area-card:before,.area-card b span,.tech-item,.tech-item img,.contact-link,.contact-link i{transition:none}.area-card:hover,.area-card:focus-visible,.tech-item:hover,.contact-link:hover{transform:none}.area-card:hover:before,.area-card:focus-visible:before{width:0}}
	/* Acabado editorial: menos superficies encerradas y más espacio entre bloques. */
	.hero{border:0;border-radius:0;box-shadow:none;background:radial-gradient(ellipse at 5% 0%,color-mix(in srgb,var(--portfolio-blue) 13%,transparent),transparent 45%),radial-gradient(ellipse at 95% 100%,color-mix(in srgb,var(--portfolio-violet) 8%,transparent),transparent 42%),transparent}
	.hero>img{border:0;border-radius:46% 46% 40% 40%;box-shadow:0 24px 65px color-mix(in srgb,var(--portfolio-blue) 16%,transparent)}
	.portfolio-note{border:0;border-left:2px solid var(--portfolio-teal);border-radius:0;background:linear-gradient(90deg,color-mix(in srgb,var(--portfolio-teal) 7%,transparent),transparent 72%);box-shadow:none}
	.area-grid{column-gap:clamp(1.2rem,4vw,3.2rem)}
	.area-card{border-bottom-color:color-mix(in srgb,var(--gray-700) 30%,transparent)}
	.area-card:hover,.area-card:focus-visible{background:linear-gradient(90deg,color-mix(in srgb,var(--card-accent) 5%,transparent),transparent 90%)}
	.tech-section{border:0;grid-template-columns:1fr;gap:1.1rem}
	.tech-list{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem clamp(1.2rem,3.8vw,3rem)}
	.tech-item{flex:0 1 auto;gap:.55rem;padding:.45rem .15rem;border:0;color:var(--gray-300)}
	.tech-item img{width:clamp(2rem,4vw,2.65rem);height:clamp(2rem,4vw,2.65rem)}
	.tech-item:hover{color:var(--gray-100);transform:translateY(-2px)}
	.contact-strip{border-top:1px solid color-mix(in srgb,var(--portfolio-violet) 25%,var(--gray-800));padding-top:1.5rem}
	.contact-link{border:0;border-bottom:1px solid color-mix(in srgb,var(--contact-accent) 28%,transparent);padding:.7rem 0}
	.contact-link:hover{background:linear-gradient(90deg,color-mix(in srgb,var(--contact-accent) 6%,transparent),transparent 90%);border-color:var(--contact-accent)}
	@media(min-width:50em){.hero{padding-inline:clamp(1rem,3vw,2.5rem)}.tech-section{grid-template-columns:minmax(12rem,.75fr) minmax(0,1.5fr);gap:2rem}.tech-list{justify-content:flex-end;gap:.6rem 1.5rem}.tech-item{display:grid;justify-items:center;gap:.5rem;min-width:5rem;text-align:center}.contact-strip{padding-top:2rem}}
	@media(max-width:32em){.hero>img{border-radius:42% 42% 36% 36%}.portfolio-note{padding:1rem 1rem 1rem 1.2rem}.tech-list{gap:.25rem 1rem}.tech-item{font-size:.78rem}}
</style>
