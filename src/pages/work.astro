---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout title="Contenido | Bases de Datos II" description="Trabajos y proyectos de Bases de Datos II">
	<div class="stack gap-20"><main class="wrapper stack gap-8"><Hero title="Contenido del semestre" tagline="Trabajos, proyectos y material académico desarrollados durante Bases de Datos II." align="start" /><Grid variant="offset">{projects.map((project) => <li><PortfolioPreview project={project} /></li>)}</Grid></main><ContactCTA /></div>
</BaseLayout>
