---
import BaseLayout from '../layouts/BaseLayout.astro';

const presentationVideoUrl = 'https://youtu.be/wyjW2f3q45Q';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const getEmbedUrl = (url: string) => {
	try {
		const parsed = new URL(url);
		const id = parsed.hostname.includes('youtu.be') ? parsed.pathname.slice(1) : parsed.searchParams.get('v') ?? parsed.pathname.split('/').filter(Boolean).pop();
		return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
	} catch { return null; }
};
const embedUrl = getEmbedUrl(presentationVideoUrl);
const focusAreas = [
	{ number: '01', title: 'Diseñar los datos', tone: 'blue', text: 'Partir de una necesidad, reconocer entidades y relaciones, y convertirlas en estructuras que mantengan la información clara y consistente.' },
	{ number: '02', title: 'Consultar y programar', tone: 'teal', text: 'Resolver preguntas con SQL y extender la lógica dentro de Oracle mediante bloques, procedimientos, funciones y otras herramientas de PL/SQL.' },
	{ number: '03', title: 'Analizar el rendimiento', tone: 'violet', text: 'Interpretar estadísticas, índices y planes de ejecución para entender cómo el motor procesa las consultas y cómo influyen los datos.' },
];
---

<BaseLayout title="Presentación | Gabriel Amortegui" description="Conoce a Gabriel Amortegui y el recorrido de aprendizaje que presenta en su portafolio de Bases de Datos II.">
	<main class="wrapper presentation">
		<header class="intro" aria-labelledby="presentation-title">
			<div class="intro-copy">
				<p class="eyebrow"><span class="eyebrow-mark"></span>PORTAFOLIO ACADÉMICO · BASES DE DATOS II</p>
				<h1 id="presentation-title">Hola, soy <span>Gabriel</span><i>.</i></h1>
				<p class="intro-role">Estudiante de Ingeniería de Sistemas <span>·</span> Quinto semestre</p>
				<div class="intro-description">
					<p>Me interesa construir soluciones donde los datos tengan una estructura clara y un propósito concreto. En Bases de Datos II he trabajado con consultas SQL, programación PL/SQL, bases documentales con MongoDB y análisis de rendimiento en Oracle.</p>
					<p>Este portafolio recoge ese recorrido mediante entregas, talleres, laboratorios, prácticas, lecturas y presentaciones. En cada evidencia explico qué se realizó, qué conceptos aprendí y cómo se relaciona ese trabajo con los demás temas del semestre.</p>
				</div>
				<div class="intro-actions">
					<a class="primary-link" href={`${base}evidencias/`}>Explorar evidencias <span aria-hidden="true">↗</span></a>
					<a class="quiet-link" href="#video-title">Ver mi presentación <span aria-hidden="true">↓</span></a>
				</div>
				<div class="topic-line" aria-label="Temas principales"><span>Modelado relacional</span><i></i><span>SQL y PL/SQL</span><i></i><span>MongoDB y MQL</span></div>
			</div>
			<figure class="portrait">
				<div class="portrait-halo"></div>
				<img src={`${base}assets/gabriel-amortegui.png`} width="1124" height="1404" alt="Retrato de Gabriel Amortegui" />
				<figcaption><span class="caption-dot"></span><span><b>Gabriel Amortegui</b><small>Ingeniería de Sistemas</small></span></figcaption>
			</figure>
		</header>

		<section class="focus-section" aria-labelledby="focus-title">
			<header class="section-heading">
				<div><p class="eyebrow">LO QUE HE EXPLORADO</p><h2 id="focus-title">Una mirada a mi aprendizaje</h2></div>
				<p>Los temas se conectan: el diseño determina cómo se consulta la información, y el comportamiento del motor ayuda a evaluar las decisiones tomadas.</p>
			</header>
			<div class="focus-grid">
				{focusAreas.map((area) => <article class="focus-item" data-tone={area.tone}><span class="focus-number">{area.number}</span><h3>{area.title}</h3><p>{area.text}</p><span class="focus-rule" aria-hidden="true"></span></article>)}
			</div>
		</section>

		<section class="video-section" aria-labelledby="video-title">
			<div class="video-heading"><p class="eyebrow">PRESENTACIÓN EN VIDEO</p><h2 id="video-title">Mi recorrido, en primera persona</h2><p>En este video comparto mi presentación y el contexto detrás del trabajo reunido en este portafolio.</p></div>
			{embedUrl ? <div class="video-frame"><iframe src={embedUrl} title="Video de presentación de Gabriel Amortegui" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen /></div> : <div class="video-placeholder"><span>▶</span><p>El video de presentación aparecerá aquí.</p></div>}
			<a class="video-link" href={presentationVideoUrl} target="_blank" rel="noopener">Abrir video en YouTube <span aria-hidden="true">↗</span></a>
		</section>
	</main>
</BaseLayout>

<style>
	.presentation{display:grid;gap:clamp(4rem,9vw,8rem);padding-block:clamp(1rem,3vw,2.5rem) 6rem}
	.intro{position:relative;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(16rem,.7fr);align-items:center;gap:clamp(2rem,6vw,6rem);min-height:34rem;padding:clamp(1rem,4vw,3rem) 0}
	.intro:before{position:absolute;z-index:-1;top:-4rem;right:-6rem;width:min(60vw,50rem);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--portfolio-violet) 13%,transparent),color-mix(in srgb,var(--portfolio-blue) 4%,transparent) 38%,transparent 70%);content:"";pointer-events:none}
	.intro-copy{position:relative;z-index:1;animation:rise-in .65s both}
	.eyebrow{display:flex;align-items:center;gap:.55rem;color:var(--portfolio-blue);font-size:.68rem;font-weight:800;letter-spacing:.14em;line-height:1.5;text-transform:uppercase}
	.eyebrow-mark{width:.45rem;height:.45rem;border-radius:50%;background:var(--portfolio-teal);box-shadow:0 0 14px color-mix(in srgb,var(--portfolio-teal) 55%,transparent)}
	h1{margin:.8rem 0 .7rem;color:var(--gray-100);font-size:clamp(3rem,8vw,6.6rem);line-height:.98;letter-spacing:-.065em}
	h1 span{color:var(--portfolio-violet)}h1 i{color:var(--portfolio-teal);font-style:normal}
	.intro-role{color:var(--gray-200);font-size:clamp(.96rem,1.4vw,1.15rem);font-weight:650}.intro-role span{padding-inline:.35rem;color:var(--portfolio-rose)}
	.intro-description{display:grid;gap:.8rem;max-width:64ch;margin-top:1.35rem}.intro-description p{color:var(--gray-400);font-size:clamp(.93rem,1.1vw,1.02rem);line-height:1.85}
	.intro-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.7rem 1.4rem;margin-top:1.5rem}
	.primary-link,.quiet-link{display:inline-flex;align-items:center;gap:.55rem;text-decoration:none;font-size:.86rem;font-weight:750;transition:color .2s ease,transform .2s ease,background .2s ease}
	.primary-link{padding:.72rem .95rem;border-radius:99px;background:var(--portfolio-blue);color:var(--portfolio-action-text);box-shadow:0 8px 24px color-mix(in srgb,var(--portfolio-blue) 20%,transparent)}
	.primary-link:hover{transform:translateY(-2px);background:var(--portfolio-violet)}
	.quiet-link{padding:.45rem 0;border-bottom:1px solid color-mix(in srgb,var(--portfolio-teal) 45%,transparent);color:var(--portfolio-teal)}
	.quiet-link:hover{transform:translateY(-1px);color:var(--gray-100)}
	.topic-line{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem .65rem;margin-top:1.8rem;color:var(--gray-500);font-size:.72rem;font-weight:650}.topic-line i{width:.24rem;height:.24rem;border-radius:50%;background:var(--portfolio-rose)}
	.portrait{position:relative;justify-self:center;width:min(100%,24rem);margin:0;animation:rise-in .8s .12s both}
	.portrait-halo{position:absolute;inset:9% -10% 3%;z-index:-1;border-radius:50%;background:radial-gradient(ellipse,color-mix(in srgb,var(--portfolio-violet) 23%,transparent),color-mix(in srgb,var(--portfolio-blue) 10%,transparent) 45%,transparent 72%);filter:blur(14px);animation:halo-breathe 6s ease-in-out infinite alternate}
	.portrait img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:center 10%;border-radius:48% 48% 42% 42%;mask-image:linear-gradient(#000 78%,transparent 100%);filter:drop-shadow(0 24px 42px color-mix(in srgb,var(--portfolio-blue) 16%,transparent));transition:transform .45s cubic-bezier(.2,.7,.2,1),filter .45s}
	.portrait:hover img{transform:translateY(-5px) rotate(1deg);filter:drop-shadow(0 30px 50px color-mix(in srgb,var(--portfolio-violet) 25%,transparent))}
	.portrait figcaption{position:relative;display:flex;align-items:center;gap:.7rem;width:max-content;max-width:90%;margin:-1.5rem auto 0;padding:.4rem 0;color:var(--gray-200)}
	.caption-dot{width:.55rem;height:.55rem;flex:none;border-radius:50%;background:var(--portfolio-teal);box-shadow:0 0 13px color-mix(in srgb,var(--portfolio-teal) 50%,transparent)}
	.portrait figcaption span:last-child{display:grid;gap:.15rem}.portrait figcaption b{font-size:.8rem}.portrait figcaption small{color:var(--gray-500);font-size:.69rem}
	.focus-section{padding-top:1.5rem}
	.section-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem;padding-bottom:1.3rem;border-bottom:1px solid var(--gray-800)}
	.section-heading h2,.video-heading h2{margin-top:.45rem;color:var(--gray-100);font-size:clamp(1.8rem,4vw,3rem);line-height:1.05;letter-spacing:-.045em}
	.section-heading>p{max-width:44ch;color:var(--gray-500);font-size:.87rem;line-height:1.7}
	.focus-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1.2rem,3vw,3rem);padding-top:1.6rem}
	.focus-item{position:relative;display:grid;align-content:start;gap:.65rem;min-width:0;padding:1.1rem 0 1.4rem;animation:rise-in .55s both}
	.focus-item:nth-child(2){animation-delay:.08s}.focus-item:nth-child(3){animation-delay:.16s}
	.focus-number{color:var(--focus-accent);font-size:.7rem;font-weight:850;letter-spacing:.12em}
	.focus-item h3{color:var(--gray-200);font-size:1.15rem;letter-spacing:-.02em}
	.focus-item p{max-width:43ch;color:var(--gray-500);font-size:.86rem;line-height:1.75}
	.focus-rule{width:2.8rem;height:2px;margin-top:.25rem;border-radius:9px;background:linear-gradient(90deg,var(--focus-accent),transparent)}
	.focus-item[data-tone="blue"]{--focus-accent:var(--portfolio-blue)}.focus-item[data-tone="teal"]{--focus-accent:var(--portfolio-teal)}.focus-item[data-tone="violet"]{--focus-accent:var(--portfolio-violet)}
	.video-section{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);align-items:center;gap:1rem 3.5rem;padding-top:1.5rem}
	.video-heading{grid-column:1;grid-row:1}.video-heading>p:last-child{max-width:37ch;margin-top:.7rem;color:var(--gray-500);font-size:.9rem;line-height:1.75}
	.video-frame,.video-placeholder{grid-column:2;grid-row:1/3;width:100%;aspect-ratio:16/9;overflow:hidden;border-radius:.85rem;background:var(--gray-900);box-shadow:0 22px 55px color-mix(in srgb,var(--portfolio-violet) 13%,transparent)}
	.video-frame iframe{display:block;width:100%;height:100%;border:0}
	.video-placeholder{display:grid;place-content:center;gap:.6rem;text-align:center;color:var(--gray-300)}.video-placeholder span{color:var(--portfolio-rose);font-size:2rem}.video-placeholder p{font-size:.95rem}
	.video-link{grid-column:2;grid-row:3;display:inline-flex;justify-self:start;align-items:center;gap:.45rem;padding:.35rem 0;border-bottom:1px solid color-mix(in srgb,var(--portfolio-rose) 48%,transparent);color:var(--portfolio-rose);font-size:.82rem;font-weight:750;text-decoration:none;transition:gap .2s,color .2s}
	.video-link:hover{gap:.7rem;color:var(--gray-100)}
	@keyframes rise-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
	@keyframes halo-breathe{from{opacity:.65;transform:scale(.97)}to{opacity:1;transform:scale(1.04)}}
	@media(max-width:54em){.intro{grid-template-columns:minmax(0,1fr) minmax(13rem,.65fr);gap:2rem;min-height:0}.section-heading{align-items:start;flex-direction:column;gap:.6rem}.focus-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.focus-item:last-child{grid-column:1/-1}.video-section{grid-template-columns:minmax(0,1fr);gap:1rem}.video-heading,.video-frame,.video-placeholder,.video-link{grid-column:1;grid-row:auto}.video-frame,.video-placeholder{grid-row:auto}}
	@media(max-width:38em){.presentation{gap:3.5rem;padding-inline:1.15rem}.intro{grid-template-columns:minmax(0,1fr);gap:1.3rem;padding-top:1.6rem}.intro-copy{order:1}.portrait{order:0;width:min(67%,16rem);margin-bottom:.2rem}.portrait figcaption{margin-top:-1rem}.intro h1{font-size:clamp(2.8rem,14vw,4.4rem)}.intro-description{margin-top:1rem}.topic-line{margin-top:1.2rem}.focus-grid{grid-template-columns:minmax(0,1fr);gap:.5rem}.focus-item{grid-template-columns:2.3rem minmax(0,1fr);column-gap:.65rem;row-gap:.35rem;padding:.9rem 0;border-bottom:1px solid var(--gray-800)}.focus-number{grid-column:1;grid-row:1/3;padding-top:.15rem}.focus-item h3,.focus-item p,.focus-rule{grid-column:2}.focus-item p{max-width:none}.video-heading h2{font-size:1.9rem}}
	@media(prefers-reduced-motion:reduce){.intro-copy,.portrait,.focus-item,.portrait-halo{animation:none!important}.portrait img,.primary-link,.quiet-link,.video-link{transition:none}.portrait:hover img,.primary-link:hover,.quiet-link:hover{transform:none}}
</style>
